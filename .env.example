# Telegram MTProto credentials — get from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=telbot

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Paths
DB_PATH=./telbot.db
RULES_PATH=./rules.yaml
PAIRS_PATH=./pair-accounts.txt
STOP_RELAY_RULES_PATH=./stop-relay-rules.txt
POLISH_PROMPT_PATH=./polish-prompt.txt
APP_CONF_PATH=./app.conf
ARCHIVE_DIR=./msg

# Logging
LOG_LEVEL=INFO
